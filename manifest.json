{
  "manifest_version": 3,
  "name": "Tichu Tracker",
  "version": "2.0.0",
  "description": "Live card tracking, hidden-hand odds and a compact move advisor for Tichu on www.dod.gr",
  "icons": {
    "16": "icons/logo-16.png",
    "32": "icons/logo-32.png",
    "48": "icons/logo-48.png",
    "96": "icons/logo-96.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.dod.gr/*"
      ],
      "css": [
        "tracker.css"
      ],
      "js": [
        "src/core.js",
        "src/probability.js",
        "tracker.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "tichu-tracker@dod.local",
      "strict_min_version": "109.0"
    }
  }
}
